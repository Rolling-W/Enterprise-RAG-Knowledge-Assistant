
# PostgreSQL
DATABASE_URL=postgresql+psycopg://erag:erag_local@localhost:5433/erag

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# Answer generation routing
# auto: GPU-enabled local Ollama first, then cloud fallback
# local: local Ollama only
# cloud: online API only
# none: disable answer generation
LLM_MODE=auto
LLM_LOCAL_ENABLED=auto
LLM_CLOUD_FALLBACK=true
LLM_TIMEOUT_SECONDS=30

# Local Ollama (started only with: docker compose --profile local-llm up -d)
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
